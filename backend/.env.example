# Copy to backend/.env and fill in. See README.md for where each value comes from.

ENVIRONMENT=development
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- Supabase --------------------------------------------------------------
# Project settings -> API. Leave SUPABASE_URL blank for purely local work; the
# auth dependency then accepts HS256 tokens signed with SUPABASE_JWT_SECRET.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=local-dev-secret-change-me

# --- Database --------------------------------------------------------------
# The application role. Supabase: Project settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/wardrobe_dev

# The read-only role from db/migrations/0004_readonly_role.sql. Kept as a
# SEPARATE secret from DATABASE_URL — it is the security backstop behind
# query_closet_items, so it must never share credentials with the app role.
READONLY_DATABASE_URL=postgresql://wardrobe_readonly:CHANGE_ME@127.0.0.1:5432/wardrobe_dev

# --- Limits (spec §5) ------------------------------------------------------
MAX_ITEMS_PER_USER=200
DAILY_MCP_CALL_LIMIT=50
