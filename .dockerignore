# Keep the build context small and keep secrets out of the image.
.git
.github
db
scripts
infra
**/.venv
# frontend/ IS needed — the first build stage compiles it. Only its installed
# dependencies and any local build output are excluded.
frontend/node_modules
frontend/dist
**/node_modules
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/*.egg-info
**/.env
**/.env.*
!**/.env.example
backend/tests
*.md
!README.md
