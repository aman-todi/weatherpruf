# Copy to frontend/.env.local and fill in. Never commit a real .env.
#
# Supabase project -> Project Settings -> API. The anon key is a publishable
# key: it is compiled into the bundle and is safe there, because every table is
# behind RLS. The service-role key must NEVER appear in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI backend is served. No trailing slash; the client appends
# /api itself. Locally this is the uvicorn dev server.
VITE_API_BASE_URL=http://localhost:8000
