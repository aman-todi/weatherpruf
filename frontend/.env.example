# Copy to frontend/.env.local and fill in. Never commit a real .env.
#
# Supabase project -> Project Settings -> API. The anon key is a publishable
# key: it is compiled into the bundle and is safe there, because every table is
# behind RLS. The service-role key must NEVER appear in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OPTIONAL. Leave unset in almost every case.
#
# The API is served from the same origin as this app: in production the FastAPI
# container serves both, and in development the Vite dev server proxies /api to
# the backend (see vite.config.ts). So the client uses relative URLs and needs
# no value here. Set it only if the frontend is ever split onto its own domain.
# VITE_API_BASE_URL=https://api.example.com

# Where `npm run dev` proxies /api to. Only needed if the backend is not on
# http://localhost:8000.
# VITE_DEV_API_TARGET=http://localhost:8000
